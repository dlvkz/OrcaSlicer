#version 400

// The tessellated surface moved by the displacement map, as the slicer moves it (displacement.glsl): along the smooth
// normal, or sideways only per layer; the face on the bed stays flat. The rest is gouraud.vs, with the flat normal of
// the part's triangle for the lighting, as the plain model has it.

layout(triangles, fractional_odd_spacing, ccw) in;

#define INTENSITY_CORRECTION 0.6

// normalized values for (-0.6/1.31, 0.6/1.31, 1./1.31)
const vec3 LIGHT_TOP_DIR = vec3(-0.4574957, 0.4574957, 0.7624929);
#define LIGHT_TOP_DIFFUSE    (0.8 * INTENSITY_CORRECTION)
#define LIGHT_TOP_SPECULAR   (0.125 * INTENSITY_CORRECTION)
#define LIGHT_TOP_SHININESS  20.0

// normalized values for (1./1.43, 0.2/1.43, 1./1.43)
const vec3 LIGHT_FRONT_DIR = vec3(0.6985074, 0.1397015, 0.6985074);
#define LIGHT_FRONT_DIFFUSE  (0.3 * INTENSITY_CORRECTION)

#define INTENSITY_AMBIENT    0.3

struct SlopeDetection
{
    bool actived;
	float normal_z;
    mat3 volume_world_normal_matrix;
};

uniform mat4 view_model_matrix;
uniform mat4 projection_matrix;
uniform mat3 view_normal_matrix;
uniform mat4 volume_world_matrix;
uniform SlopeDetection slope;
uniform vec2 z_range;
uniform vec4 clipping_plane;
uniform vec4 color_clip_plane;

#include "displacement.glsl"

in vec3 te_position[];
in vec3 te_normal[];
in vec2 te_tex_coord[];

out vec2 intensity;
out vec3 clipping_planes_dots;
out float color_clip_plane_dot;
out vec4 world_pos;
out float world_normal_z;
out vec3 eye_normal;
out vec3 eye_position;
out vec3 world_normal;
out vec2 tex_coord;
out vec3 disp_base_pos;
out vec3 disp_base_eye;

void main()
{
    vec3 b = gl_TessCoord;
    vec3 p = b.x * te_position[0] + b.y * te_position[1] + b.z * te_position[2];
    vec3 smooth_n = b.x * te_normal[0] + b.y * te_normal[1] + b.z * te_normal[2];
    vec2 uv = b.x * te_tex_coord[0] + b.y * te_tex_coord[1] + b.z * te_tex_coord[2];
    // The triangle's own normal, for the lighting and for which faces are steep.
    vec3 face_n = cross(te_position[1] - te_position[0], te_position[2] - te_position[0]);
    face_n = dot(face_n, face_n) > 0.0 ? normalize(face_n) : normalize(smooth_n);

    vec4 base_world = volume_world_matrix * vec4(p, 1.0);
    vec3 moved = p;
    if (disp_active && base_world.z > 0.001) {
        // On the triangle's edges the surface moves along the smooth normal, which the triangle next to it shares, so
        // the two meet. Within EDGE_BAND mm of the edges it turns to the triangle's own normal, so large flat faces of a
        // low-poly part move straight out.
        const float EDGE_BAND = 1.0;
        mat3 lin = mat3(volume_world_matrix);
        vec3 w0 = lin * te_position[0], w1 = lin * te_position[1], w2 = lin * te_position[2];
        float area2 = length(cross(w1 - w0, w2 - w0));
        float edge_dist = min(min(b.x * area2 / max(length(w2 - w1), 1e-9), b.y * area2 / max(length(w0 - w2), 1e-9)),
                              b.z * area2 / max(length(w1 - w0), 1e-9));
        vec3 smooth_w = normalize(lin * smooth_n);
        vec3 face_w = normalize(lin * face_n);
        vec3 n = normalize(mix(smooth_w, face_w, clamp(edge_dist / EDGE_BAND, 0.0, 1.0)));
        float h = disp_height(vec3(base_world.xy - disp_center, base_world.z), uv, n);
        vec3 dir = n;
        bool move = true;
        if (disp_walls_only) {
            move = dot(n.xy, n.xy) >= 0.5;
            dir = move ? vec3(normalize(n.xy), 0.0) : vec3(0.0);
        }
        if (move)
            moved = p + inverse(mat3(volume_world_matrix)) * (dir * h);
    }

    eye_normal = normalize(view_normal_matrix * face_n);
    float NdotL = max(dot(eye_normal, LIGHT_TOP_DIR), 0.0);
    intensity.x = INTENSITY_AMBIENT + NdotL * LIGHT_TOP_DIFFUSE;
    vec4 position = view_model_matrix * vec4(moved, 1.0);
    intensity.y = LIGHT_TOP_SPECULAR * pow(max(dot(-normalize(position.xyz), reflect(-LIGHT_TOP_DIR, eye_normal)), 0.0), LIGHT_TOP_SHININESS);
    NdotL = max(dot(eye_normal, LIGHT_FRONT_DIR), 0.0);
    intensity.x += NdotL * LIGHT_FRONT_DIFFUSE;

    world_pos = volume_world_matrix * vec4(moved, 1.0);
    disp_base_pos = base_world.xyz;
    disp_base_eye = (view_model_matrix * vec4(p, 1.0)).xyz;
    world_normal_z = slope.actived ? (normalize(slope.volume_world_normal_matrix * face_n)).z : 0.0;
    eye_position = position.xyz;
    world_normal = mat3(volume_world_matrix) * face_n;
    tex_coord = uv;
    gl_Position = projection_matrix * position;
    clipping_planes_dots = vec3(dot(world_pos, clipping_plane), world_pos.z - z_range.x, z_range.y - world_pos.z);
    color_clip_plane_dot = dot(world_pos, color_clip_plane);
}

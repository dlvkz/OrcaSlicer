+ggml_tensor* ggml_ext_conv_2d_flat(GGMLRunnerContext* runner_ctx,
+                                   ggml_tensor* x,
+                                   ggml_tensor* w,
+                                   ggml_tensor* b,
+                                   int KW,
+                                   int KH,
+                                   int s0,
+                                   int s1,
+                                   int p0,
+                                   int p1,
+                                   int d0,
+                                   int d1,
+                                   bool circular_x,
+                                   bool circular_y,
+                                   float scale) {
+    auto ctx         = runner_ctx->ggml_ctx;
+    const int64_t IC = x->ne[2];
+    const int64_t N  = x->ne[3];
+    const int64_t OC = w->ne[1];
+    GGML_ASSERT(w->ne[0] == IC * KH * KW);
+    if (scale != 1.f) {
+        x = ggml_ext_scale(runner_ctx, x, scale);
+    }
+    if ((p0 != 0 || p1 != 0) && (circular_x || circular_y)) {
+        x  = ggml_ext_pad_ext(runner_ctx, x, p0, p0, p1, p1, 0, 0, 0, 0, circular_x, circular_y);
+        p0 = 0;
+        p1 = 0;
+    }
+    // im2col reads only the kernel's shape, so a view of x with that shape stands in for it
+    // (the real kernel is quantized and cannot be viewed as [KW, KH, IC]).
+    ggml_tensor* kshape = ggml_view_4d(ctx, x, KW, KH, IC, 1, x->nb[1], x->nb[2], x->nb[3], 0);
+    ggml_tensor* cols   = ggml_im2col(ctx, kshape, x, s0, s1, p0, p1, d0, d1, true, GGML_TYPE_F32);  // [N, OH, OW, IC*KH*KW]
+    const int64_t OW    = cols->ne[1];
+    const int64_t OH    = cols->ne[2];
+    cols                = ggml_reshape_2d(ctx, cols, cols->ne[0], OW * OH * N);
+    ggml_tensor* y      = ggml_mul_mat(ctx, w, cols);  // [N*OH*OW, OC]
+    y                   = ggml_reshape_4d(ctx, y, OC, OW, OH, N);
+    y                   = ggml_cont(ctx, ggml_permute(ctx, y, 2, 0, 1, 3));  // [N, OC, OH, OW]
+    if (scale != 1.f) {
+        y = ggml_ext_scale(runner_ctx, y, 1.f / scale);
+    }
+    if (b != nullptr) {
+        b = ggml_reshape_4d(ctx, b, 1, 1, b->ne[0], 1);
+        y = ggml_add_inplace(ctx, y, b);
+    }
+    return y;
+}
+
 ggml_tensor* ggml_ext_conv_2d(GGMLRunnerContext* runner_ctx,
                               ggml_tensor* x,
                               ggml_tensor* w,
